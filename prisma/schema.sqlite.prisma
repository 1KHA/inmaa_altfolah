// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Database configuration
datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Team {
  id                   String    @id @default(cuid())
  teamName             String?
  status               String    @default("pending") // pending, approved, rejected
  // Disabling a team disables every member with it (see src/lib/account-status.ts).
  isDisabled           Boolean   @default(false)
  disabledAt           DateTime?
  phaseId              String?
  phase                Phase?    @relation(fields: [phaseId], references: [id])
  phaseStatus          String    @default("active") // active | failed
  phaseUpdatedAt       DateTime?
  hackathonTrack       String?   // NEW: أي مسار من مسارات الهاكاثون؟
  ideaDescription      String?   // SIMPLIFIED: صف الفكرة
  hearAboutUs          String?   // NEW: من أين سمعت عنا
  isTeamRegistration   Boolean   @default(true) // NEW: distinguish team vs individual
  attachmentPath       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  participants         Participant[]
  receivedJoinRequests TeamJoinRequest[]
  
  // DEPRECATED FIELDS - Keep for backward compatibility
  challenge            String?
  challengeReason      String?
  ideaName             String?
  ideaSolution         String?
  ideaResults          String?
  ideaStage            String?
  attachmentsLink      String?
  hasParticipated      Boolean?
  participationDetails String?
}

model Participant {
  id                   String                @id @default(cuid())
  // NEW CSV-based fields
  fullName             String?               // الاسم كاملًا
  contactNumber        String?               // رقم التواصل
  gender               String?               // الجنس المتقدم: ذكر أم أنثى؟
  isUniversityStudent  Boolean?              // هل أنت طالب في الجامعة؟
  universityMajor      String?               // اذكر تخصصك الجامعي
  professionalField    String?               // ماهو مجالك المهني؟
  city                 String?               // المدينة
  canAttendHackathon   Boolean?              // هل تستطيع التواجد خلال فترة الهاكاثون؟
  
  // Core fields
  email                String                @unique
  badgeCode            String?               @unique // QR badge token, lazy-generated (MIYAHTHONE-XXXXXXXXXXXX)
  university           String?               // اذكر جامعتك
  isLeader             Boolean               @default(false)
  passwordHash         String?
  status               String                @default("pending") // pending, approved, rejected (for individual participants)
  // Account disabled by an admin: cannot log in, cannot act, and receives no
  // transactional email/notifications. Independent of `status` (which is the
  // application review outcome) so re-enabling restores the previous state.
  // A participant is EFFECTIVELY disabled when this is true OR their team is
  // disabled — see src/lib/account-status.ts.
  isDisabled           Boolean               @default(false)
  disabledAt           DateTime?
  phaseId              String?
  phase                Phase?                @relation(fields: [phaseId], references: [id])
  phaseStatus          String                @default("active") // active | failed
  phaseUpdatedAt       DateTime?
  teamId               String?               // Make optional for individual participants
  team                 Team?                 @relation(fields: [teamId], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bookings             MentorBooking[]
  submissions          MilestoneSubmission[]
  eventRegistrations   EventRegistration[]
  sentJoinRequests     TeamJoinRequest[]
  attendanceRecords    AttendanceRecord[]
  
  // DEPRECATED FIELDS - Keep for backward compatibility
  firstName            String?
  secondName           String?
  familyName           String?
  nationalId           String?
  dob                  String?
  phoneNumber          String?
  education            String?
  major                String?
  employmentStatus     String?
  nationality          String?
  residence            String?
  canAttend            Boolean?
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Mentor {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  specialty      String
  phone          String
  status         String               @default("pending") // pending, active, inactive
  // Disabled by an admin: cannot log in, cannot act, receives no transactional
  // email, and is not bookable. See src/lib/account-status.ts.
  isDisabled     Boolean              @default(false)
  disabledAt     DateTime?
  passwordHash   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  availabilities MentorAvailability[]
}

model MentorAvailability {
  id        String          @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  mentorId  String
  mentor    Mentor          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  bookings  MentorBooking[]
}

model MentorBooking {
  id             String             @id @default(cuid())
  participantId  String
  participant    Participant        @relation(fields: [participantId], references: [id])
  availabilityId String
  availability   MentorAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  status         String             @default("booked") // booked, cancelled, completed
  // Auto-generated video-meeting room for this session (Jitsi by default —
  // see src/lib/meeting.ts). Sent to the mentor and the booking team by email.
  meetingUrl     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Milestone {
  id              String                @id @default(cuid())
  title           String
  description     String
  dueDate         DateTime
  status          String                @default("upcoming") // upcoming, active, completed, overdue
  // Tying a milestone to a phase is what enables auto-advance on acceptance.
  // A milestone with no phase behaves exactly as before and moves nobody.
  phaseId         String?
  phase           Phase?                @relation(fields: [phaseId], references: [id])
  // Escape hatch: accept uploads after dueDate, flagged isLate on the submission.
  allowLateSubmission Boolean           @default(false)
  requirements    String                // JSON string of requirements array
  submissionCount Int                   @default(0)
  submissionLink  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  submissions     MilestoneSubmission[]
}

model MilestoneSubmission {
  id            String      @id @default(cuid())
  participant   Participant @relation(fields: [participantId], references: [id])
  participantId String
  milestone     Milestone   @relation(fields: [milestoneId], references: [id])
  milestoneId   String
  filePath      String
  fileName      String
  submittedAt   DateTime    @default(now())
  reviewStatus  String?     // pending | accepted | rejected | needs_resubmission
  // Resubmission: the row is updated in place, keeping @@unique([participantId, milestoneId]).
  resubmissionCount       Int       @default(0)
  resubmissionRequestedAt DateTime?
  resubmissionDeadline    DateTime? // overrides milestone.dueDate for this submission
  isLate                  Boolean   @default(false)
  reviewComment String?     // Admin's comment on the submission
  reviewedAt    DateTime?   // When the submission was reviewed

  @@unique([participantId, milestoneId])
}

model Event {
  id           String             @id @default(cuid())
  title        String
  description  String
  startDate    DateTime
  endDate      DateTime
  location     String
  capacity     Int
  type         String
  plan         String
  presenter    String
  status       String             @default("upcoming") // upcoming, active, completed, cancelled
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  // Last time an admin sent a manual reminder for this event — powers the
  // "already sent X ago" warning and the server-side re-send cooldown.
  lastReminderAt DateTime?
  registrations EventRegistration[]
}

model EventRegistration {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  status        String      @default("registered") // registered, cancelled, attended, absent
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([participantId, eventId])
}

model Notification {
  id                String    @id @default(cuid())
  title             String    // Short notification title
  message           String    // Detailed notification message
  type              String    // success, info, warning, error
  isRead            Boolean   @default(false)
  recipientType     String    // admin, participant, mentor
  recipientId       String    // ID of the recipient
  relatedEntityType String?   // team, event, milestone, mentor, participant
  relatedEntityId   String?   // ID of related entity
  actionUrl         String?   // Optional URL for clickable notifications
  emailStatus       String?   // null = no email attempted, sent, failed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([recipientType, recipientId, createdAt])
  @@index([recipientType, recipientId, isRead])
}

model TeamJoinRequest {
  id            String   @id @default(cuid())
  participantId String   // Individual requesting to join
  teamId        String   // Team they want to join
  status        String   @default("pending") // pending, accepted, rejected
  message       String?  // Optional message from participant
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  participant   Participant @relation(fields: [participantId], references: [id])
  team          Team        @relation(fields: [teamId], references: [id])
  
  @@unique([participantId, teamId]) // Prevent duplicate requests
}

model EmailSettings {
  id              String   @id @default(cuid())
  host            String   @default("")
  port            Int      @default(587)
  secure          Boolean  @default(false)
  username        String   @default("")
  password        String   @default("") // AES-256-GCM encrypted, "enc:v1:" prefix
  fromEmail       String   @default("")
  fromName        String   @default("")
  adminInboxEmail String   @default("") // shared inbox for admin-facing notifications
  enabled         Boolean  @default(false) // master switch
  updatedAt       DateTime @updatedAt
}

model NotificationTemplate {
  key              String   @id // e.g. "teamApproval"
  label            String   // Arabic display name
  category         String   // admin, participant, mentor
  dashboardTitle   String
  dashboardMessage String
  emailSubject     String
  emailBody        String   // plain text with {{vars}}, rendered into RTL HTML shell
  emailEnabled     Boolean  @default(true)
  actionUrl        String?  // null = use code default
  variables        String   // JSON array of allowed placeholder names
  updatedAt        DateTime @updatedAt
}

model EmailLog {
  id             String   @id @default(cuid())
  templateKey    String?
  broadcastId    String?
  toEmail        String   // single recipient, or a summary for BCC batches
  recipientCount Int      @default(1)
  subject        String
  status         String   // sent, failed
  error          String?
  messageId      String?  // nodemailer message id
  createdAt      DateTime @default(now())

  @@index([templateKey, createdAt])
  @@index([broadcastId])
  @@index([createdAt])
}

model Broadcast {
  id                String   @id @default(cuid())
  title             String
  body              String
  emailSubject      String?
  channels          String   // JSON array: ["dashboard","email"]
  audience          String   // JSON audience descriptor
  notificationCount Int      @default(0)
  emailSentCount    Int      @default(0)
  emailFailedCount  Int      @default(0)
  createdBy         String   // admin id
  createdAt         DateTime @default(now())
  // Email queue lifecycle: completed (no email / all done) | queued | sending | partial (done, some failed)
  status            String   @default("completed")
  totalRecipients   Int      @default(0) // email recipients enqueued (0 for dashboard-only)
  recipients        BroadcastRecipient[]

  @@index([createdAt])
}

/// One row per email recipient of a broadcast — the persistent, resumable send
/// queue drained by /api/cron/drain-email-queue (and inline via waitUntil).
/// See mdfiles/email-queue.md.
model BroadcastRecipient {
  id                String    @id @default(cuid())
  broadcastId       String
  broadcast         Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  recipientType     String    // participant | mentor | admin (admin = the shared inbox, one row)
  recipientId       String
  email             String
  notificationId    String?   // dashboard Notification row to stamp emailStatus on
  status            String    @default("pending") // pending | sending | sent | failed
  attempts          Int       @default(0)
  error             String?
  providerMessageId String?
  claimedAt         DateTime? // set when a drainer claims the row; stale claims are re-claimed
  nextAttemptAt     DateTime? // retry backoff for transport-level failures
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@unique([broadcastId, email]) // idempotency: never double-send within a broadcast
  @@index([status, nextAttemptAt, createdAt]) // the claim query
  @@index([broadcastId, status])             // progress counters
}

model AttendanceRecord {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  eventId       String?     // null = general venue check-in
  checkinDate   String?     // YYYY-MM-DD (Asia/Riyadh), set only for general check-ins
  scannedBy     String      // admin id
  method        String      // scan, manual
  createdAt     DateTime    @default(now())

  @@unique([participantId, eventId]) // NULLs distinct: only constrains event rows
  @@unique([participantId, checkinDate]) // NULLs distinct: only constrains general rows
  @@index([eventId])
  @@index([checkinDate])
}

// Admin-controlled window during which team leaders may add members.
// Null start/end = unrestricted on that side. Single default row.
model TeamSettings {
  id             String    @id @default(cuid())
  memberAddStart DateTime?
  memberAddEnd   DateTime?
  updatedAt      DateTime  @updatedAt
}

/// An ordered stage of the hackathon. Teams and participants sit in exactly one
/// phase; milestones can be tied to a phase to advance their owners on
/// acceptance. See mdfiles/phases-plan.md.
model Phase {
  id           String    @id @default(cuid())
  name         String    @unique
  order        Int       @unique // 1,2,3 — defines what "next"/"previous" mean
  description  String?
  // Disabling a phase disables every member with it, derived exactly like a
  // disabled team (see src/lib/account-status.ts) — member rows are untouched.
  isDisabled   Boolean   @default(false)
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  teams        Team[]
  participants Participant[]
  milestones   Milestone[]

  @@index([order])
}
