{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/broadcast/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/broadcast/[id]/retry/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/drain-email-queue/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/bulk-approve/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/email-queue/drain/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/accounts/disable/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/booking-reminders/route.ts": {
      "maxDuration": 300
    }
  },
  "buildCommand": "chmod +x vercel-build.sh && ./vercel-build.sh",
  "env": {
    "DATABASE_TYPE": "postgresql"
  },
  "crons": [
    {
      "path": "/api/cron/drain-email-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "* * * * *"
    }
  ]
}
